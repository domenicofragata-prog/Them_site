@font-face { font-family: "Cormorant"; src: url("/wish-room/font/CormorantGaramond[wght].ttf") format("truetype"); font-weight: 300 700; font-style: normal; font-display: swap; }
@font-face { font-family: "Cormorant"; src: url("/wish-room/font/CormorantGaramond-Italic[wght].ttf") format("truetype"); font-weight: 300 700; font-style: italic; font-display: swap; }
:root { --notte: #000; --panna: #efe9dc; --panna-tenue: #b7b0a2; --grigio: #76716a; --filo: rgba(239, 233, 220, .14); --cielo: #7fa2dc; --ghiaccio: #ecf2fc;
  --testo: "Cormorant", "Cormorant Garamond", Garamond, Georgia, serif; --ebraico: "Frank Ruhl Libre", "Cormorant", serif; --mono: "Space Mono", monospace; }
* { box-sizing: border-box; }
html, body { margin: 0; background: var(--notte); color: var(--panna); }
body { font: 400 clamp(18px, 2.3vh, 24px)/1.5 var(--testo); overflow-x: clip; }
p { margin: 0; }
.frecce { position: fixed; top: 0; left: 0; right: 0; z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 3vw; padding: 14px clamp(16px, 3vw, 36px);
  font: 500 clamp(12px, 1.6vh, 15px)/1.4 var(--testo); font-variant: small-caps; letter-spacing: .2em; color: var(--panna-tenue);
  background: linear-gradient(to bottom, rgba(0, 0, 0, .97) 70%, transparent); pointer-events: none; }
.frecce a { color: inherit; text-decoration: none; pointer-events: auto; display: inline-flex; align-items: center; gap: .8em; padding: 6px 0; transition: color .5s; }
.frecce a:hover { color: var(--panna); }
.frecce svg { width: 34px; height: 10px; stroke: currentColor; fill: none; stroke-width: 1; flex: none; }
.lingue { display: flex; gap: 1em; pointer-events: auto; letter-spacing: .14em; }
.lingue a { padding: 6px 2px; color: var(--grigio); }
.lingue a.qui { color: var(--panna); }
main { width: min(1320px, 100% - 8vw); margin: 0 auto; padding: 12vh 0 10vh; animation: entra 1.4s ease; }
@keyframes entra { from { opacity: 0; transform: translateY(1vh); } to { opacity: 1; transform: none; } }
.testa { display: flex; flex-direction: column; gap: 3vh; margin-bottom: 7vh; }
.marca { font: 500 clamp(12px, 1.7vh, 16px)/1.4 var(--testo); font-variant: small-caps; letter-spacing: .32em; color: var(--grigio); }
.marca b { color: var(--panna-tenue); font-weight: 500; }
h1 { margin: 0; font: italic 300 clamp(40px, 7.4vh, 78px)/1.02 var(--testo); letter-spacing: -.01em; }
.motto { font: italic 400 clamp(20px, 2.9vh, 28px)/1.35 var(--testo); }
/* il metodo: a sinistra le parole, a destra la figura che si traccia e resta in vista */
.metodo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(28px, 5vw, 80px); align-items: start; }
.parole { display: flex; flex-direction: column; gap: 2.6vh; color: var(--panna-tenue); max-width: 60ch; }
.parole b, .intro b { font-weight: 500; font-variant: small-caps; letter-spacing: .14em; color: var(--panna); }
.stanze { display: grid; grid-template-columns: repeat(3, 1fr); direction: rtl; gap: 1px; background: var(--filo); border: 1px solid var(--filo); max-width: 480px; margin: .4vh 0 1vh; }
.stanze div { direction: ltr; background: var(--notte); padding: 1.2vh .4em 1vh; display: flex; flex-direction: column; align-items: center; gap: .1vh; }
.stanze .fila { display: flex; flex-direction: row-reverse; justify-content: center; gap: .7em; }
.stanze .una { display: flex; flex-direction: column; align-items: center; }
.stanze .let { font: 400 clamp(20px, 2.8vh, 26px)/1.2 var(--ebraico); color: var(--ghiaccio); }
.stanze .nl { font: italic 400 clamp(11px, 1.5vh, 14px)/1.2 var(--testo); color: var(--grigio); }
.stanze .num { font: 400 clamp(11px, 1.5vh, 13px)/1.3 var(--mono); color: var(--cielo); }
.schema { margin: 0; display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 1.1vh 1.4em; padding: 1.8vh 1.2em; border: 1px solid var(--filo); align-items: baseline; }
.schema dt { font: 500 clamp(12px, 1.6vh, 15px)/1.4 var(--testo); font-variant: small-caps; letter-spacing: .2em; color: var(--grigio); }
.schema dd { margin: 0; font: 400 clamp(12px, 1.7vh, 15px)/1.5 var(--mono); color: var(--ghiaccio); }
.scena { position: sticky; top: 64px; display: flex; flex-direction: column; align-items: center; gap: 1.2vh; }
#nascita { display: block; width: min(100%, calc(100vh - 370px)); width: min(100%, calc(100svh - 370px)); min-width: min(100%, 320px); aspect-ratio: 1; }
.nomi { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: .2vh 1.3em; }
.nomi button { all: unset; cursor: pointer; display: inline-flex; align-items: baseline; gap: .45em; color: var(--grigio); transition: color .5s; }
.nomi button:hover, .nomi button:focus-visible { color: var(--panna-tenue); }
.nomi button[aria-pressed="true"] { color: var(--panna); }
.nomi .eb { font: 400 clamp(16px, 2.2vh, 20px)/1.3 var(--ebraico); color: var(--cielo); opacity: .6; }
.nomi button[aria-pressed="true"] .eb { opacity: 1; color: var(--ghiaccio); }
.nomi .tr { font: 500 clamp(11px, 1.5vh, 14px)/1.3 var(--testo); font-variant: small-caps; letter-spacing: .16em; }
.dida { text-align: center; display: flex; flex-direction: column; gap: .3vh; min-height: 5.4em; }
.dida .nome { font: 400 clamp(17px, 2.3vh, 22px)/1.3 var(--testo); color: var(--panna); }
.dida .nome bdi { font-family: var(--ebraico); color: var(--ghiaccio); margin-right: .5em; font-size: 1.1em; }
.dida .nome i { color: var(--panna-tenue); }
.eti { font: 500 clamp(11px, 1.6vh, 15px)/1.4 var(--testo); font-variant: small-caps; letter-spacing: .22em; color: var(--grigio); }
.comandi { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 1.2vh 1.6em; width: 100%; }
.comandi label { display: inline-flex; align-items: center; gap: .9em; }
.comandi input[type=range] { -webkit-appearance: none; appearance: none; width: min(46vw, 260px); height: 1px; background: var(--panna-tenue); outline: none; cursor: pointer; }
.comandi input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 13px; height: 13px; border-radius: 50%; background: var(--ghiaccio); border: 0; }
.comandi input[type=range]::-moz-range-thumb { width: 13px; height: 13px; border-radius: 50%; background: var(--ghiaccio); border: 0; }
.comandi input[type=range]:focus-visible { outline: 1px solid var(--cielo); outline-offset: 8px; }
.comandi button { background: transparent; color: var(--panna); border: 1px solid var(--panna-tenue); border-radius: 0; padding: .8vh 1.5em; cursor: pointer;
  font: 500 clamp(12px, 1.6vh, 15px)/1.3 var(--testo); font-variant: small-caps; letter-spacing: .24em; transition: background .5s, color .5s; }
.comandi button:hover { background: var(--panna); color: var(--notte); }
/* le misure: nome, numero, ragione */
.misure { list-style: none; margin: 3vh 0 0; padding: 0; max-width: 1040px; border-top: 1px solid var(--filo); }
.misure li { display: grid; grid-template-columns: 4.2em minmax(9em, 13em) 2.6em minmax(0, 1fr); align-items: baseline; column-gap: 1.1em; padding: 1.3vh 0; border-bottom: 1px solid var(--filo); }
.misure .eb { font: 400 clamp(19px, 2.7vh, 25px)/1.3 var(--ebraico); color: var(--ghiaccio); text-align: right; }
.misure .tr { font: 500 clamp(13px, 1.8vh, 16px)/1.3 var(--testo); font-variant: small-caps; letter-spacing: .18em; color: var(--panna); }
.misure .tr i { font: italic 400 clamp(14px, 1.9vh, 17px)/1.3 var(--testo); font-variant: normal; letter-spacing: 0; color: var(--grigio); }
.misure .num { font: 400 clamp(15px, 2.1vh, 19px)/1.3 var(--mono); color: var(--cielo); text-align: right; }
.misure .perche { color: var(--panna-tenue); font-size: clamp(16px, 2.1vh, 20px); line-height: 1.45; }
/* le tavole */
.intro { color: var(--panna-tenue); max-width: 62ch; margin: 11vh 0 0; }
.galleria { list-style: none; margin: 4vh 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: clamp(22px, 3vw, 40px) clamp(16px, 2vw, 28px); }
.galleria button { all: unset; box-sizing: border-box; cursor: pointer; display: flex; flex-direction: column; gap: 1.2vh; width: 100%; }
.galleria .quadro { position: relative; aspect-ratio: 4 / 3; background: #000; outline: 1px solid var(--filo); overflow: hidden; transition: outline-color .6s; }
.galleria img { width: 100%; height: 100%; object-fit: cover; display: block; opacity: .82; transition: opacity .6s, transform 1.6s ease; }
.galleria button:hover img, .galleria button:focus-visible img { opacity: 1; transform: scale(1.03); }
.galleria button:hover .quadro, .galleria button:focus-visible .quadro { outline-color: var(--cielo); }
.galleria .capo { display: flex; align-items: baseline; gap: .9em; }
.galleria .num { font: 500 clamp(11px, 1.6vh, 15px)/1.4 var(--testo); letter-spacing: .26em; color: var(--grigio); }
.galleria .tit { font: italic 400 clamp(20px, 2.7vh, 26px)/1.2 var(--testo); color: var(--panna); }
.galleria .riga { font-size: clamp(15px, 2vh, 18px); line-height: 1.4; color: var(--panna-tenue); }
/* la lente: una tavola viva, sola, sul nero */
#lente { position: fixed; inset: 0; z-index: 20; display: none; flex-direction: column; background: #000; }
#lente.aperta { display: flex; animation: entra .4s ease; }
#lente header { display: flex; align-items: center; justify-content: space-between; gap: 2vw; padding: 8px clamp(12px, 2vw, 24px); border-bottom: 1px solid var(--filo);
  font: 500 clamp(12px, 1.6vh, 15px)/1.4 var(--testo); font-variant: small-caps; letter-spacing: .2em; color: var(--panna-tenue); }
#lente header span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#lente nav { display: flex; align-items: center; gap: .4em; flex: none; }
#lente button { border: 0; background: none; color: var(--panna-tenue); font: 300 clamp(24px, 3.6vh, 34px)/1 var(--testo); padding: 6px 14px; cursor: pointer; }
#lente button:hover, #lente button:focus-visible { color: var(--panna); outline: none; }
#lente iframe { flex: 1; width: 100%; border: 0; background: #000; }
footer { margin-top: 8vh; font: 500 clamp(11px, 1.5vh, 14px)/1.5 var(--testo); font-variant: small-caps; letter-spacing: .3em; color: var(--grigio); }
@media (max-width: 900px) {
  .frecce .nome { display: none; } main { width: calc(100% - 10vw); }
  .metodo { grid-template-columns: 1fr; }
  .scena { position: static; order: -1; } #nascita { width: 100%; }
  .misure li { grid-template-columns: 3.6em 1fr 2.4em; row-gap: .4vh; } .misure .perche { grid-column: 1 / -1; }
}
@media (prefers-reduced-motion: reduce) { main { animation: none; } .galleria img { transition: none; } }
</style>
</head>
<body>
<nav class="frecce">
  <a href={OPERA[lingua]}><svg viewBox="0 0 34 10" aria-hidden="true"><path d="M33 5H1m5-4L1 5l5 4"/></svg><span class="nome">{T.opera}</span></a>
  <div class="lingue">
    <a href={VIE.it} class={lingua === 'it' ? 'qui' : ''} lang="it">IT</a>
    <a href={VIE.en} class={lingua === 'en' ? 'qui' : ''} lang="en">EN</a>
  </div>
</nav>
<main>
  <div class="testa">
    <div class="marca"><b>{T.opera}</b> · them</div>
    <h1>{T.titolo}</h1>
    <p class="motto">{T.motto}</p>
  </div>
  <section class="metodo">
    <div class="parole">
      <p><b>{T.stanze[0]}</b> {T.stanze[1]}</p>
      <div class="stanze" role="img" aria-label={T.stanze[0]}>
        {STANZE.map((lettere, s) => <div><span class="fila">{lettere.map((x) => <span class="una"><span class="let" lang="he">{x.l}</span><span class="nl">{x.nome}</span></span>)}</span><span class="num">{s + 1}</span></div>)}
      </div>
      {T.blocchi.slice(0, 4).map(([capo, p]) => <p><b>{capo}</b> {p}</p>)}
      <p><b>{T.regola.capo}</b> {T.regola.testo}</p>
      <dl class="schema">
        {T.regola.righe.map(([nome, conto]) => <><dt>{nome}</dt><dd>{conto}</dd></>)}
      </dl>
      <p>{T.regola.dopo}</p>
      {T.blocchi.slice(4).map(([capo, p]) => <p><b>{capo}</b> {p}</p>)}
    </div>
    <div class="scena">
      <ul class="nomi" id="nomi">
        {EBRAICO.map((e, i) => (
          <li><button type="button" data-n={i} aria-pressed={i === 0 ? 'true' : 'false'} title={SENSI[lingua][i]}><bdi class="eb" lang="he">{e}</bdi><span class="tr">{NOMI[i]}</span></button></li>
        ))}
      </ul>
      <canvas id="nascita" role="img" aria-label={T.motto}></canvas>
      <div class="dida">
        <p class="nome" id="nome"><bdi lang="he">{EBRAICO[0]}</bdi>{NOMI[0]}, <i>{SENSI[lingua][0]}</i></p>
        <p class="eti" id="riga1">&nbsp;</p>
        <p class="eti" id="riga2">&nbsp;</p>
      </div>
      <div class="comandi">
        <label class="eti"><span>{T.cursore}</span><input type="range" id="giri" min="1" max="18" value="6" step="1" aria-label={T.cursore}></label>
        <button type="button" id="ritraccia">{T.ritraccia}</button>
      </div>
    </div>
  </section>
  <p class="intro"><b>{T.misure[0]}</b> {T.misure[1]}</p>
  <ul class="misure">
    {MISURE.map((m, i) => (
      <li><bdi class="eb" lang="he">{EBRAICO[i]}</bdi><span class="tr">{NOMI[i]}, <i>{SENSI[lingua][i]}</i></span><span class="num">{m.r}</span><span class="perche">{m[lingua]}</span></li>
    ))}
  </ul>
  <p class="intro"><b>{T.tavole[0]}</b> {T.tavole[1]}</p>
  <ul class="galleria" id="galleria">
    {TAVOLE.map((t, i) => (
      <li><button type="button" data-i={i} aria-label={`${T.apri} ${t.n}, ${t[lingua][0]}`}>
        <span class="quadro"><img src={`/meditazioni/tavole/miniature/${t.n}.jpg`} alt="" loading="lazy" width="720" height="540"></span>
        <span class="capo"><span class="num">{t.n}</span><span class="tit">{t[lingua][0]}</span></span>
        <span class="riga">{t[lingua][1]}</span>
      </button></li>
    ))}
  </ul>
  <footer>{T.opera} · THEM</footer>
</main>
<div id="lente" role="dialog" aria-modal="true" aria-label={T.titolo}>
  <header>
    <span id="lente-titolo"></span>
    <nav>
      <button type="button" class="prima" aria-label={T.prima}>‹</button>
      <button type="button" class="dopo" aria-label={T.dopo}>›</button>
      <button type="button" class="chiudi" aria-label={T.chiudi}>×</button>
    </nav>
  </header>
  <iframe title={T.titolo}></iframe>
</div>
<script is:inline src="/meditazioni/middah.js"></script>
<script is:inline src="/meditazioni/nascita.js"></script>
<script is:inline define:vars={{ elenco, parole }}>
const $ = s => document.querySelector(s), P = parole;
const numero = (n, d) => { const s = n.toFixed(d).replace(/\.?0+$/, ""); return P.lingua === "it" ? s.replace(".", ",") : s; };
// la figura che si traccia
function avviso(st) {
  $("#nome").innerHTML = `<bdi lang="he">${st.parola}</bdi>${P.nomi[st.sefirah]}, <i>${P.sensi[st.sefirah]}</i>`;
  $("#riga1").textContent = `${P.misura} ${st.misura} · ${P.figura} ${st.figura} ${P.di} ${st.figure} · ${st.giri} ${P.giri} · ${P.svolta} ${numero(st.svolta, 1)}°`;
  $("#riga2").textContent = st.chiusa ? `${P.chiusa} · ${st.tratti} ${P.tratti} · ${P.lunghezza} ${st.lunghezza} · ${P.totale} ${st.totale.toLocaleString(P.lingua === "it" ? "it-IT" : "en-US")}` : `${P.tratto} ${st.tratto} ${P.di} ${st.tratti} · ${P.ripetizione} ${st.ripetizione} ${P.di} ${st.misura}`;
  const g = $("#giri"); if (+g.max !== st.figure) g.max = st.figure; if (+g.value !== st.figura) g.value = st.figura;
  document.querySelectorAll("#nomi button").forEach((b, i) => b.setAttribute("aria-pressed", i === st.sefirah ? "true" : "false"));
}
Nascita.avvia($("#nascita"), { avviso });
$("#nomi").addEventListener("click", e => { const b = e.target.closest("button"); if (b) Nascita.parola(+b.dataset.n); });
$("#giri").addEventListener("input", e => Nascita.sorella(+e.target.value));
$("#ritraccia").addEventListener("click", () => Nascita.traccia());
// le tavole: una alla volta, aprendone un'altra la precedente si scarica
const LENTE = $("#lente"), QUADRO = LENTE.querySelector("iframe");
let aperta = -1, guardata = null;
function mostra(i) { aperta = (i + elenco.length) % elenco.length; const t = elenco[aperta]; $("#lente-titolo").textContent = `${P.tavola} ${t.n} · ${t.titolo}`; QUADRO.src = `/meditazioni/tavole/${t.file}.html`; }
function apri(i) { guardata = document.activeElement; mostra(i); LENTE.classList.add("aperta"); document.body.style.overflow = "hidden"; LENTE.querySelector(".chiudi").focus(); }
function chiudi() { LENTE.classList.remove("aperta"); document.body.style.overflow = ""; aperta = -1; QUADRO.src = "about:blank"; if (guardata) guardata.focus({ preventScroll: true }); }
$("#galleria").addEventListener("click", e => { const b = e.target.closest("button"); if (b) apri(+b.dataset.i); });
LENTE.querySelector(".chiudi").onclick = chiudi;
LENTE.querySelector(".prima").onclick = () => mostra(aperta - 1);
LENTE.querySelector(".dopo").onclick = () => mostra(aperta + 1);
addEventListener("keydown", e => { if (aperta >= 0 && e.key === "Escape") chiudi(); });
</script>
</body>
</html>
