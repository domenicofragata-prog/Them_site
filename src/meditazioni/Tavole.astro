---
// Le tavole preparatorie delle Meditazioni cabalistiche: come nasce una figura e perché si chiude.
// In alto il metodo, con una figura che si traccia dal vivo, public/meditazioni/nascita.js; sotto, nove tavole
// scelte da Dome fra quelle di meaning-machine/esperimenti-middah, copiate in public/meditazioni/tavole con i soli
// percorsi cambiati. Si aprono una alla volta.
// Nei testi niente parentesi, ogni parola ebraica ha accanto traslitterazione e traduzione.
import '@fontsource/frank-ruhl-libre/hebrew-400.css';
import '@fontsource/space-mono/latin-400.css';

interface Props { lingua: 'it' | 'en' }
const { lingua } = Astro.props;
const VIE = { it: '/meditazioni-cabalistiche/tavole', en: '/en/kabbalistic-meditations/plates' };
const OPERA = { it: '/meditazioni-cabalistiche', en: '/en/kabbalistic-meditations' };

const NOMI = ['Keter', 'Chokhmah', 'Binah', 'Chesed', 'Gevurah', 'Tiferet', 'Netzach', 'Hod', 'Yesod', 'Malkhut', 'Da’at'];
const EBRAICO = ['כתר', 'חכמה', 'בינה', 'חסד', 'גבורה', 'תפארת', 'נצח', 'הוד', 'יסוד', 'מלכות', 'דעת'];
const SENSI = { it: ['corona', 'sapienza', 'intelligenza', 'misericordia', 'forza', 'bellezza', 'vittoria', 'splendore', 'fondamento', 'regno', 'conoscenza'],
  en: ['crown', 'wisdom', 'understanding', 'mercy', 'strength', 'beauty', 'victory', 'splendour', 'foundation', 'kingdom', 'knowledge'] };
// le nove stanze di Aiq Bekar: la lettera numero n dell'alfabeto sta nella stanza n mod 9
const ALFABETO = [...'אבגדהוזחטיכלמנסעפצקרשת'];
const NOMI_LETTERE = ['alef', 'bet', 'gimel', 'dalet', 'he', 'vav', 'zayin', 'chet', 'tet', 'yod', 'kaf', 'lamed', 'mem', 'nun', 'samekh', 'ayin', 'pe', 'tzadi', 'qof', 'resh', 'shin', 'tav'];
const STANZE = Array.from({ length: 9 }, (_, s) => ALFABETO.map((l, i) => ({ l, nome: NOMI_LETTERE[i], i })).filter((x) => x.i % 9 === s));

// Le misure dei nomi e la loro ragione: sono le scelte approvate da Dome il 17 novembre 2026, tabella SCELTE di
// meaning-machine/porte231/lettura.html. Netzach e Hod sono accostamenti dell'opera, senza una fonte che leghi loro il numero.
// Conti verificati: אל 1+30, il nome di quattro lettere 10+5+6+5, Netzach ordinale 14+18+8, הוד 5+6+4, חי 8+10.
const MISURE = [
  { r: 13, it: 'Tredici, come le tredici misure di misericordia che lo Zohar pone nell’Antico Santo, il volto divino che corrisponde a Keter.', en: 'Thirteen, as the thirteen measures of mercy that the Zohar sets in the Holy Ancient One, the divine countenance that corresponds to Keter.' },
  { r: 32, it: 'Trentadue, come le trentadue vie mirabili di sapienza con cui si apre il Sefer Yetzirah.', en: 'Thirty-two, as the thirty-two wondrous paths of wisdom that open the Sefer Yetzirah.' },
  { r: 50, it: 'Cinquanta, come le cinquanta porte dell’intelligenza di cui parla il Talmud e che i cabalisti leggono come porte di Binah.', en: 'Fifty, as the fifty gates of understanding the Talmud speaks of, which the kabbalists read as the gates of Binah.' },
  { r: 31, it: 'Trentuno, il valore di El, Dio, il nome divino di Chesed: alef 1 e lamed 30.', en: 'Thirty-one, the value of El, God, the divine name of Chesed: alef 1 and lamed 30.' },
  { r: 42, it: 'Quarantadue, come le lettere del nome di quarantadue lettere, di cui parla il Talmud e che Moshe Cordovero riferisce a Gevurah. Il nome divino proprio di Gevurah è Elohim, Dio.', en: 'Forty-two, as the letters of the forty-two-letter name, which the Talmud mentions and Moshe Cordovero refers to Gevurah. The divine name of Gevurah itself is Elohim, God.' },
  { r: 26, it: 'Ventisei, il valore del nome di quattro lettere, che è il nome divino di Tiferet: yod 10, he 5, vav 6, he 5.', en: 'Twenty-six, the value of the four-letter name, which is the divine name of Tiferet: yod 10, he 5, vav 6, he 5.' },
  { r: 40, it: 'Quaranta, il valore ordinale di Netzach: nun è la quattordicesima lettera, tzadi la diciottesima, chet l’ottava. Quaranta è un numero di purificazione e di passaggio: quaranta giorni cade la pioggia del diluvio, quaranta se’ah, una misura di capacità, è l’acqua del miqveh, il bagno rituale, quaranta giorni resta Mosè sul Sinai. Il legame con Netzach è un accostamento dell’opera.', en: 'Forty, the ordinal value of Netzach: nun is the fourteenth letter, tzadi the eighteenth, chet the eighth. Forty is a number of purification and passage: forty days the rain of the flood falls, forty se’ah, a measure of capacity, is the water of the miqveh, the ritual bath, forty days Moses stays on Sinai. The tie with Netzach is a pairing made by the work.' },
  { r: 15, it: 'Quindici, il valore di Hod, che è anche il suo valore ordinale: he 5, vav 6, dalet 4. È lo stesso della forma breve del nome divino, yod 10 e he 5, che la tradizione assegna a Chokhmah e non a Hod. È un accostamento dell’opera.', en: 'Fifteen, the value of Hod, which is also its ordinal value: he 5, vav 6, dalet 4. It is the same as the short form of the divine name, yod 10 and he 5, which tradition assigns to Chokhmah and not to Hod. It is a pairing made by the work.' },
  { r: 18, it: 'Diciotto, il valore di חי chai, vivente: chet 8 e yod 10. Il nome divino di Yesod è El Chai, il Dio vivente.', en: 'Eighteen, the value of חי chai, living: chet 8 and yod 10. The divine name of Yesod is El Chai, the living God.' },
  { r: 10, it: 'Dieci: Malkhut è la decima sefirah e riceve le altre nove.', en: 'Ten: Malkhut is the tenth sefirah and receives the other nine.' },
  { r: 11, it: 'Undici: Da’at esiste ma non si conta. La tradizione conta sempre dieci sefirot, dieci e non undici come dice il Sefer Yetzirah, e Da’at resta una sefirah fantasma, presente e fuori dal numero. L’undici, il primo numero oltre il dieci, è la misura che le dà l’opera.', en: 'Eleven: Da’at exists but is not counted. Tradition always counts ten sefirot, ten and not eleven as the Sefer Yetzirah says, and Da’at remains a phantom sefirah, present and outside the number. Eleven, the first number beyond ten, is the measure the work gives it.' },
];

const TAVOLE = [
  { n: '01', file: 'tavola_01_griglia', it: ['La griglia di lettere', 'La linea posata su una griglia: ogni cella porta la lettera del tratto che la attraversa. La figura comincia a essere scritta con il suo stesso nome.'], en: ['The grid of letters', 'The line laid on a grid: each cell carries the letter of the stroke that crosses it. The figure begins to be written with its own name.'] },
  { n: '02', file: 'tavola_02_animata', it: ['Lettere in movimento', 'Dove la linea passa più volte le lettere si sommano e la luce cresce. La figura si scrive nel tempo, un tratto dopo l’altro.'], en: ['Letters in motion', 'Where the line passes more than once the letters add up and the light grows. The figure is written through time, one stroke after another.'] },
  { n: '03', file: 'tavola_03_nero', it: ['Il nero', 'La stessa scrittura sola sul nero, a tutto schermo.'], en: ['Black', 'The same writing alone on black, full screen.'] },
  { n: '04', file: 'tavola_04_vecchio_computer', it: ['Vecchio computer', 'Fosforo azzurro, scia lunga, righe del tubo: la figura come su un terminale.'], en: ['Old computer', 'Blue phosphor, a long trail, scan lines: the figure as on a terminal.'] },
  { n: '05', file: 'tavola_05_alfanumerico', it: ['Lettere e numeri', 'Accanto alle lettere i numeri delle loro stanze, cioè le lunghezze dei tratti: la misura scritta dentro la figura.'], en: ['Letters and numbers', 'Beside the letters the numbers of their chambers, that is the lengths of the strokes: the measure written inside the figure.'] },
  { n: '06', file: 'tavola_06_ferme', it: ['Le undici figure', 'Gli undici nomi a linea appena chiusa, uno accanto all’altro.'], en: ['The eleven figures', 'The eleven names with the line just closed, side by side.'] },
  { n: '11', file: 'tavola_11_famiglia', it: ['La famiglia', 'Tutte le figure che un nome chiude con la sua misura, al variare dei giri. Qui nasce l’idea della famiglia.'], en: ['The family', 'All the figures a name closes with its measure, as the full turns vary. Here the idea of the family is born.'] },
  { n: '23', file: 'tavola_23_undici_famiglie', it: ['Le undici famiglie', 'Sette figure per ogni famiglia, a colpo d’occhio: stelle e rosoni per i nomi con misura piccola, fasce fitte per quelli con misura grande.'], en: ['The eleven families', 'Seven figures for each family, at a glance: stars and rosettes for the names with a small measure, dense bands for those with a large one.'] },
  { n: '24', file: 'tavola_24_le_22_lettere', it: ['Le 22 lettere', 'Il metodo applicato ai nomi delle lettere, con svolta a 72 gradi: ogni nome, che ha da due a quattro lettere, si chiude in cinque ripetizioni. Sotto ogni ornamento, le parole del Tanakh, la Bibbia ebraica, che disegnano lo stesso.'], en: ['The 22 letters', 'The method applied to the names of the letters, with a turning angle of 72 degrees: each name, which has two to four letters, closes in five repetitions. Under each ornament, the words of the Tanakh, the Hebrew Bible, that draw the same one.'] },
];

const T = {
  it: {
    titolo: 'Tavole preparatorie', opera: 'Meditazioni cabalistiche',
    descrizione: 'Come nasce una figura delle Meditazioni cabalistiche e perché si chiude: le nove stanze di Aiq Bekar, le misure delle sefirot, la famiglia, e le tavole di lavoro.',
    titoloPagina: 'Tavole preparatorie delle Meditazioni cabalistiche: sefirot, Aiq Bekar, Albero della vita',
    temi: ['cabala', 'sefirot', 'Albero della vita', 'Aiq Bekar', 'lettere ebraiche'],
    motto: 'Come nasce una figura, e perché si chiude.',
    blocchi: [
      ['Il tratto.', 'Ogni lettera diventa un tratto, lungo quanto il numero della sua stanza. כתר Keter, corona, ha tre lettere: כ kaf sta nella stanza 2, ת tav nella 4, ר resh nella 2. La parola è una spezzata di tre tratti lunghi 2, 4 e 2.'],
      ['La svolta.', 'Dopo ogni tratto la linea svolta di un angolo, sempre lo stesso e sempre dalla stessa parte. La forma della spezzata viene tutta da qui: le lunghezze le dà la parola, l’angolo è uno solo.'],
      ['La chiusura.', 'Finita la parola, la linea la riscrive da capo senza staccarsi. Ogni ripetizione è la stessa spezzata, girata rispetto alla precedente della somma delle sue svolte. Quando le ripetizioni hanno preso tutte le direzioni in parti uguali, a raggiera, i loro spostamenti si annullano: la linea è tornata al punto di partenza e la figura è chiusa.'],
      ['La misura.', 'La misura è quante volte il nome si ripete nella linea: 13 per Keter. Scelta la misura, la svolta non è libera. Deve valere un numero intero di giri diviso per il numero dei tratti, che per Keter sono 13 per 3, cioè 39. Con 6 giri la svolta è 360 per 6 diviso 39, poco più di 55 gradi.'],
      ['La famiglia.', 'Il numero dei giri può cambiare, purché non abbia divisori in comune con la misura: altrimenti la figura si chiuderebbe prima, oppure, se i giri sono un multiplo della misura, non si chiuderebbe affatto. Ogni numero ammesso dà una svolta e una figura. All’inizio della famiglia la svolta è dolce e la figura è larga e vuota. Crescendo i giri la linea si incrocia sempre di più, in stelle e trame fitte, e ogni volta che i giri si avvicinano a un multiplo della misura la figura torna ad aprirsi in anello. Tolte le speculari, Keter ne ha 18: il cursore sotto la figura le scorre tutte.'],
      ['Perché le famiglie non si somigliano.', 'Conta soprattutto la misura, cioè quante volte la figura ripete sé stessa intorno al centro. A colpo d’occhio i nomi con misura piccola, come Keter con 13 o הוד Hod, splendore, con 15, danno stelle, rosoni e girandole. Quelli con misura grande, come בינה Binah, intelligenza, con 50, danno fasce e dischi fitti.'],
    ],
    regola: { capo: 'La regola.', testo: 'È deterministica: date la parola, la misura e il numero dei giri, la figura è una sola, a meno di rotazione, grandezza e verso, e chi rifà il conto la ritrova identica. Per Keter, misura 13 e 6 giri:',
      righe: [['la parola', 'כתר Keter, corona · valore 20 + 400 + 200 = 620'], ['le stanze', '2 · 4 · 2 · tre tratti, somma 8'], ['la svolta', '360 × giri ∕ (misura × lettere) = 360 × 6 ∕ 39, circa 55,4°'], ['la chiusura', 'ripetizioni = misura ∕ MCD(giri, misura) = 13 ∕ MCD(6, 13) = 13'], ['valore totale', 'misura × valore = 13 × 620 = 8.060'], ['linea', 'misura × somma delle stanze = 13 × 8 = 104']],
      dopo: 'La famiglia comincia dalla figura con la svolta più vicina a 60 gradi, la svolta dell’esagono regolare, e a parità da quella con meno giri. Poi prosegue in ordine di giri. Se una ripetizione girasse di un numero intero di giri la linea non si chiuderebbe: sarebbe un fregio che avanza. Le nove stanze vengono dalla tradizione. Il tracciato a misura e svolta è il metodo dell’opera, un’invenzione nostra.' },
    stanze: ['Le stanze.', 'Le ventidue lettere ebraiche stanno in nove stanze. È la tavola di Aiq Bekar, che prende il nome dalle prime due: א alef, י yod, ק qof, poi ב bet, כ kaf, ר resh. Nella stessa stanza stanno le lettere che in ghematria valgono lo stesso numero in unità, decine e centinaia: alef 1, yod 10, qof 100. Nella tradizione la tavola conta ventisette segni, perché comprende le cinque forme finali, che valgono da 500 a 900 e completano le ultime cinque stanze. Qui bastano le ventidue lettere: quelle stanze ne tengono due, e una forma finale conta come la lettera normale. Il numero della stanza, da 1 a 9, è la lunghezza del tratto.'],
    misure: ['Le ripetizioni.', 'Ogni nome si ripete un numero preciso di volte, e quel numero è la sua misura. Per alcune sefirot è un numero che i testi della cabala legano a quella sefirah. Per altre è tratto da un nome divino che le è assegnato, per valore ghematrico o per numero di lettere. Per altre ancora è il valore del nome della sefirah o il suo posto nell’ordine. In ghematria ogni lettera è anche un numero, e una parola vale la somma delle sue lettere. Farne il numero delle ripetizioni è una scelta dell’opera, e dove anche il legame è nostro, è detto. I nomi divini delle sefirot seguono שערי אורה Sha’arei Orah, le porte della luce, di Yosef Gikatilla.'],
    tavole: ['Le tavole.', 'Trovata la linea, restava da darle una materia. Queste sono le tavole di lavoro, pagine vive con i loro comandi: la linea diventa scrittura, poi famiglia, e alla fine il metodo torna sulle lettere stesse. Si aprono una alla volta.'],
    giri: 'giri', cursore: 'figura', ritraccia: 'Traccia da capo', misura: 'misura', figura: 'figura', di: 'di', svolta: 'svolta', tratto: 'tratto', ripetizione: 'ripetizione', chiusa: 'chiusa', tratti: 'tratti', lunghezza: 'linea', totale: 'valore totale',
    apri: 'Apri la tavola', chiudi: 'Chiudi', prima: 'Tavola precedente', dopo: 'Tavola seguente', tavola: 'tavola', stanza: 'stanza',
  },
  en: {
    titolo: 'Preparatory plates', opera: 'Kabbalistic Meditations',
    descrizione: 'How a figure of the Kabbalistic Meditations is born and why it closes: the nine chambers of Aiq Bekar, the measures of the sefirot, the family, and the working plates.',
    titoloPagina: 'Preparatory plates of the Kabbalistic Meditations: sefirot, Aiq Bekar, Tree of Life',
    temi: ['Kabbalah', 'sefirot', 'Tree of Life', 'Aiq Bekar', 'Hebrew letters'],
    motto: 'How a figure is born, and why it closes.',
    blocchi: [
      ['The stroke.', 'Each letter becomes a stroke, as long as the number of its chamber. כתר Keter, crown, has three letters: כ kaf is in chamber 2, ת tav in 4, ר resh in 2. The word is a broken line of three strokes, 2, 4 and 2 long.'],
      ['The turn.', 'After each stroke the line turns by an angle, always the same and always to the same side. The whole shape comes from this: the lengths are given by the word, the angle is a single one.'],
      ['The closing.', 'When the word is done, the line writes it again without lifting. Each repetition is the same broken line, rotated from the one before by the sum of its turns. When the repetitions have taken every direction in equal parts, like spokes, their displacements cancel out: the line is back where it started and the figure is closed.'],
      ['The measure.', 'The measure is how many times the name repeats in the line: 13 for Keter. Once the measure is chosen, the turning angle is not free. It must be a whole number of full turns divided by the number of strokes, which for Keter is 13 times 3, that is 39. With 6 full turns the turning angle is 360 times 6 divided by 39, a little over 55 degrees.'],
      ['The family.', 'The number of full turns may change, as long as it shares no divisor with the measure: otherwise the figure would close too soon or, if the full turns are a multiple of the measure, would not close at all. Each allowed number gives one turning angle and one figure. At the start of the family the bend is gentle and the figure wide and empty. As the full turns grow the line crosses itself more and more, in stars and dense weaves, and each time they come near a multiple of the measure the figure opens again into a ring. Mirror images aside, Keter has 18: the slider under the figure goes through them all.'],
      ['Why the families do not look alike.', 'What counts most is the measure, that is how many times the figure repeats itself around the centre. At a glance the names with a small measure, like Keter with 13 or הוד Hod, splendour, with 15, give stars, rosettes and pinwheels. Those with a large measure, like בינה Binah, understanding, with 50, give bands and dense discs.'],
    ],
    regola: { capo: 'The rule.', testo: 'It is deterministic: given the word, the measure and the number of full turns, the figure is one only, up to rotation, size and handedness, and whoever redoes the count finds it identical. For Keter, measure 13 and 6 full turns:',
      righe: [['the word', 'כתר Keter, crown · value 20 + 400 + 200 = 620'], ['the chambers', '2 · 4 · 2 · three strokes, sum 8'], ['the turning angle', '360 × full turns ∕ (measure × letters) = 360 × 6 ∕ 39, about 55.4°'], ['the closing', 'repetitions = measure ∕ GCD(full turns, measure) = 13 ∕ GCD(6, 13) = 13'], ['total value', 'measure × value = 13 × 620 = 8,060'], ['line', 'measure × sum of the chambers = 13 × 8 = 104']],
      dopo: 'The family starts from the figure whose turning angle is closest to 60 degrees, the turning angle of the regular hexagon, and in a tie from the one with fewer full turns. Then it goes on in order of full turns. If one repetition turned by a whole number of full turns the line would not close: it would be a frieze moving on. The nine chambers come from tradition. Drawing by measure and turn is the method of the work, an invention of ours.' },
    stanze: ['The chambers.', 'The twenty-two Hebrew letters sit in nine chambers. It is the table of Aiq Bekar, named after the first two: א alef, י yod, ק qof, then ב bet, כ kaf, ר resh. In the same chamber sit the letters that in gematria are worth the same number in units, tens and hundreds: alef 1, yod 10, qof 100. In tradition the table counts twenty-seven signs, because it includes the five final forms, worth 500 to 900, which complete the last five chambers. Here the twenty-two letters are enough: those chambers hold two, and a final form counts as the ordinary letter. The number of the chamber, from 1 to 9, is the length of the stroke.'],
    misure: ['The repetitions.', 'Each name repeats a precise number of times, and that number is its measure. For some sefirot it is a number that the texts of Kabbalah tie to that sefirah. For others it is drawn from a divine name assigned to it, by gematria value or by number of letters. For others still it is the value of the name of the sefirah or its place in the order. In gematria every letter is also a number, and a word is worth the sum of its letters. Making it the number of repetitions is a choice of the work, and where the tie itself is ours, it is said. The divine names of the sefirot follow שערי אורה Sha’arei Orah, the gates of light, by Yosef Gikatilla.'],
    tavole: ['The plates.', 'Once the line was found, it still needed a matter. These are the working plates, live pages with their controls, which are in Italian: the line becomes writing, then family, and in the end the method returns to the letters themselves. They open one at a time.'],
    giri: 'full turns', cursore: 'figure', ritraccia: 'Draw again', misura: 'measure', figura: 'figure', di: 'of', svolta: 'turning angle', tratto: 'stroke', ripetizione: 'repetition', chiusa: 'closed', tratti: 'strokes', lunghezza: 'line', totale: 'total value',
    apri: 'Open the plate', chiudi: 'Close', prima: 'Previous plate', dopo: 'Next plate', tavola: 'plate', stanza: 'chamber',
  },
}[lingua];
const elenco = TAVOLE.map((t) => ({ n: t.n, file: t.file, titolo: t[lingua][0] }));
const parole = { lingua, nomi: NOMI, sensi: SENSI[lingua], misura: T.misura, figura: T.figura, di: T.di, svolta: T.svolta, giri: T.giri, tratto: T.tratto, ripetizione: T.ripetizione, chiusa: T.chiusa, tratti: T.tratti, lunghezza: T.lunghezza, totale: T.totale, tavola: T.tavola };
// Quello che la pagina dichiara ai motori di ricerca: un articolo sull'opera, con autore e temi.
const dati = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: T.titoloPagina, description: T.descrizione, inLanguage: lingua, url: `https://themproject.ai${VIE[lingua]}`,
  image: 'https://themproject.ai/meditazioni/og.jpg', keywords: T.temi.join(', '),
  about: T.temi.slice(0, 4).map((t) => ({ '@type': 'Thing', name: t })),
  author: { '@type': 'Person', '@id': 'https://themproject.ai/#person', name: 'Domenico Fragata', url: 'https://themproject.ai/' },
  isPartOf: { '@id': 'https://themproject.ai/meditazioni-cabalistiche#opera' },
};
---
